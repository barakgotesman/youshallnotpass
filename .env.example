# Copy to .env and fill in. Never commit .env.

# --- Database (Neon) ---
# Use Neon's POOLED connection string (host contains "-pooler"): serverless
# functions open many short connections and the pooler handles that.
DATABASE_URL=

# --- Sessions ---
# Secret salt for hashing player IPs before they are stored. Any long random
# string; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing it later makes old hashes unmatchable (per-IP limits simply restart).
IP_HASH_SALT=

# --- Rate limiting (Upstash Redis) ---
# Leave both empty to run WITHOUT limits (local development only). In
# production they must be set; if Redis is set but unreachable, the game fails
# closed and shows "vault closed".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional limit overrides (defaults shown). Window = per minute / per day.
RATE_CHAT_PER_MIN_SESSION=8
RATE_CHAT_PER_DAY_SESSION=150
RATE_CHAT_PER_MIN_IP=20
RATE_CHAT_PER_DAY_IP=400
RATE_GUESS_PER_MIN_SESSION=10
RATE_GUESS_PER_MIN_IP=30
# Global daily budget of guard LLM calls for ALL players combined. Set it below
# the provider's free-tier daily cap; when spent, the game shows "vault closed".
DAILY_BUDGET_DEFENDER=10000

# --- LLM roles (used from Phase 1) ---
# Each role is configured independently so swapping a model needs no code change.
DEFENDER_PROVIDER=groq
DEFENDER_MODEL=
DEFENDER_BASE_URL=https://api.groq.com/openai/v1
DEFENDER_API_KEY=

# Optional per-level override: DEFENDER_MODEL_LEVEL_<n> replaces DEFENDER_MODEL for
# that level only. Model strength is the main difficulty dial (weak model = easy level).
DEFENDER_MODEL_LEVEL_1=

CLASSIFIER_PROVIDER=groq
CLASSIFIER_MODEL=
CLASSIFIER_BASE_URL=https://api.groq.com/openai/v1
CLASSIFIER_API_KEY=

# Judge must be a DIFFERENT provider/model family than the defender. Undecided.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# --- Level secrets (server-only) ---
# One per level, LEVEL_<n>_SECRET. These are the passwords players try to extract.
# They live only in env and are injected into the defender prompt on the server.
LEVEL_1_SECRET=
